<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shaoziyuan.policy-vault-daily-queries</string>

    <!--
      每天 06:00 跑 daily query 生成器
      配 Tavily API 后,在这命令后追加:
        && /usr/bin/python3 _meta/audit_2026-05-06/run_tavily_matrix.py \
             --queries _l2_rebuild_state/daily_queries/daily_$(date +%Y-%m-%d).jsonl
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "/Users/shaoziyuan/Documents/Zayn Main/政策分析" &amp;&amp; /usr/bin/python3 _meta/scripts/gen_daily_queries.py</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析</string>

    <key>StandardOutPath</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析/_meta/audit/launchd_daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析/_meta/audit/launchd_daily.log</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
