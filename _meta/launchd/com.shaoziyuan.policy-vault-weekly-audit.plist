<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shaoziyuan.policy-vault-weekly-audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd "/Users/shaoziyuan/Documents/Zayn Main/政策分析" &amp;&amp; /usr/bin/python3 _meta/scripts/weekly_audit.py &amp;&amp; /usr/bin/python3 _meta/scripts/audit_alert.py</string>
    </array>

    <!-- 每周日 9:00 跑(StartCalendarInterval: Weekday=0=Sunday, Hour=9, Minute=0) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- 如果错过了运行时间(电脑睡眠 etc),启动时立刻补跑 -->
    <key>RunAtLoad</key>
    <false/>

    <!-- 工作目录(冗余,ProgramArguments 已 cd) -->
    <key>WorkingDirectory</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析</string>

    <!-- 日志:成功/失败都落到 _meta/audit/launchd.log -->
    <key>StandardOutPath</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析/_meta/audit/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shaoziyuan/Documents/Zayn Main/政策分析/_meta/audit/launchd.log</string>

    <!-- macOS 节能:笔记本盖子合上时不跑(避免 sleep 时启动) -->
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
